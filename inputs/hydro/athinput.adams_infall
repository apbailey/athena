<comment>
problem   = Adams & Batygin 2022 ballistic infall onto a forming giant planet
reference = Adams, F. C. & Batygin, K. 2022, ApJ, 934, 111
configure = --prob=adams_infall --coord=spherical_polar --eos=adiabatic --flux=hllc -hdf5
            (isothermal+MPI: --eos=isothermal --flux=hlle -mpi -hdf5 --hdf5_path=...)

<job>
problem_id = AdamsInfall   # basename of output filenames

<output1>
file_type  = hst           # history file
dt         = 0.1

<output2>
file_type   = hdf5         # HDF5 primitive dumps (athdf format)
variable    = prim
dt          = 2.0          # 51 dumps over tlim=100; sparser than t<=30 runs
ghost_zones = true         # include ghost cells in dumps

<time>
cfl_number = 0.3
nlim       = -1
tlim       = 100.0
integrator = vl2
xorder     = 2
ncycle_out = 100

<mesh>
# Domain: r in [0.1*R_H, R_H]. With qthermal=1: R_H = (1/3)^(1/3) = 0.69336,
# x1min = 0.069336, x1max = 0.69336. theta in [0, pi/2] (pole to equator).
# The outer boundary is at R_H (paper eq. 1) so the Adams ballistic solution
# is applied exactly where it's valid.
nx1        = 256
x1min      = 0.069336127435
x1max      = 0.693361274350
ix1_bc     = user        # diode outflow: copy + clamp v_r <= 0
ox1_bc     = user        # analytic infall
x1rat      = 1.00903504815  # logarithmic stretching = 10^(1/nx1) for r span of 10x

nx2        = 128
x2min      = 0.0
x2max      = 1.5707963267948966     # pi/2 (pole -> equator)
ix2_bc     = polar_wedge
ox2_bc     = user        # diode outflow: copy + clamp v_theta >= 0

nx3        = 1
x3min      = 0.0
x3max      = 6.283185307179586      # 2 pi (single azimuthal slab; 2D axisymmetric)
ix3_bc     = periodic
ox3_bc     = periodic

refinement = None

<meshblock>
nx1        = 128
nx2        = 64
nx3        = 1

<hydro>
gamma           = 1.6666667
iso_sound_speed = 1.0       # c_s = 1 in code units
dfloor          = 1.0e-8
pfloor          = 1.0e-10

<problem>
qthermal      = 1.0          # dimensionless thermal mass = GM_p in code units
flux_function = isotropic    # Taylor & Adams 2024 / Adams 2025 inflow geometry:
                             #   polar | quasipolar | isotropic
                             #   quasiequatorial | equatorial
                             #   gaussian | gaussian_normalized
lambda        = 1.0          # Adams 2025 angular-momentum bias J = lambda Omega R_H^2
                             # (R_C = lambda^2 R_H / 3; lambda=1 -> Adams 2022)
hill_source       = false    # rotational frame sources: Coriolis +
                             # tidal radial (-1.5 R^2 <cos^2 phi>). axisymmetric.
vertical_gravity  = false    # tidal vertical compression (+0.5 z^2),
                             # independent of hill_source.
